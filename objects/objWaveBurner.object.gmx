            <kind>1</kind>
            <string>var bulletLimit = 4;
var weaponCost = 0.375;
var action = 1; // 0 - no frame; 1 - shoot; 2 - throw
var willStop = 1; // If this is 1, the player will halt on shooting ala Metal Blade.
var sineTimer = 0;
var bulletTimer = 0;

/*
if !(global.characterSelected[playerID]) == "Bass"
{
    global.weaponPrimaryColor[global.weapon[playerID]] = global.nesPalette[18];
    global.weaponSecondaryColor[global.weapon[playerID]] = global.nesPalette[33];
}
else
{
    global.weaponPrimaryColor[global.weapon[playerID]] = global.nesPalette[22];
    global.weaponSecondaryColor[global.weapon[playerID]] = global.nesPalette[36];
}
*/

if (!(global.keyShoot[playerID] &amp;&amp; !playerIsLocked(PL_LOCK_SHOOT))){
    
    isCharge = false;
    chargeTime = 5;
    sineTimer = 0
    col1 = 1;
    col2 = 1;

}
else{

    if (global.ammo[playerID, global.weapon[playerID]] &gt; 0){

        isCharge = true;
        chargeTimer ++;
        //sineTimer += 1
        
        if (chargeTimer &gt;= 5){
        
            i = fireWeapon(16, 0, objWaveBurner, 4, 0.25, 1, 0);
            if (i){
                i.xspeed = 2 * image_xscale;
                i.yspeed = sin(chargeTime) * image_yscale
                i.image_xscale = image_xscale;
                chargeTimer = 0;
                playSFX(sfxSFFlame);
                sineTimer += 1
                chargeTime += (0.5);
            }
            
        }
        
    }

}
</string>
          </argument>
        </arguments>
      </action>
