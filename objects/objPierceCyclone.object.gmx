            <string>event_inherited();

if entityCanStep()
{
    imgIdx = ((imgIdx + imgSpd) mod imgNum);
    
    if xcoll != 0
    {
        deathTimer = 30;
    }
    
    if deathTimer &gt;= 0
    {
        deathTimer = max(deathTimer - 1, 0)
        if deathTimer == 0
        {
            event_user(EV_DEATH)
        }
        xspeed = 0;
        yspeed = 0;
    }
    else
    {
        sinTimer ++;
        imgSpd = 0.5;
    }
    
    sprite_index = spr;
    image_index = imgIdx;
}
</string>
