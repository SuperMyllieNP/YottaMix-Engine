    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();

xspeed = cos(degtorad(angle)) * spd * image_xscale;
yspeed = -sin(degtorad(angle)) * spd;

animTimerA += 0.5

if (global.keyShootPressed[playerID]) &amp;&amp; phizysFuckingSucksLol == 0
{
    phizysFuckingSucksLol = 1
    instance_destroy();
    var b = instance_create(x, y, objSingleLoopEffect);
    b.sprite_index = sprExplosion;
    b.image_speed = 1/2;
    
    playSFX(sfxStegorusMissile);
    
    for (i = 1; i &lt; 4; i ++)
    {
        var a = instance_create(x, y, objVulcanSplit);
        a.sploinkyDoinky = -1
        a.targAngle = ((i - 2) * 90)
        a.phizysFuckingSucksLol = 1
        a.image_xscale = image_xscale
    };
    
}

if sploinkyDoinky &lt;= 0
{   
    if (angle) &lt; (targAngle)
    {
        angle += 5
    }
    else if (angle) &gt; (targAngle)
    {
        angle -= 5
    }
    //correctDirection(targAngle, 4)
    //else if
    //angle += 4
}

image_index = ((floor(angle / 45)) * 2) + floor(animTimerA mod 2)
</string>
          </argument>
        </arguments>
      </action>
    </event>
