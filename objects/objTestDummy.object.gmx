        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// This tough chicken will run forwards and jump over Megaman.

event_inherited();

healthpointsStart = 9999999999;
healthpoints = healthpointsStart;
contactDamage = 0.01;

//@cc
//category = "nature, bird, bulky";

//@cc
facePlayerOnSpawn = true;

// Enemy specific code
plyr = noone;
plyrID = 0;

primCol = 0;
secCol = 0;
outCol = 0;

imgIdx = 0;
imgSpd = 0;

rockTimer = 0;

spr = sprMylliePlush;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();

    if instance_exists(objMegaman)
    {
        plyr = instance_nearest(x, y, objMegaman);
        plyrID = plyr.playerID;
        if global.weaponPrimaryColor[global.weapon[plyrID]] == -1
        {
            primCol = make_color_rgb(23, 255, 142);
            secCol = c_white;
            outCol = c_black;
        }
        else
        {
            primCol = global.primaryCol[plyrID];
            secCol = global.secondaryCol[plyrID];
            outCol = global.outlineCol[plyrID];
        }
    }
    else
    {
        plyr = noone;
        plyrID = 0;
        
        primCol = make_color_rgb(23, 255, 142);
        secCol = c_white;
        outCol = c_black;
    }

if (entityCanStep())
{    
    image_speed = 0;
    image_index = 0;
    
    rockTimer = max(rockTimer - 1, 0);
    imgIdx = (imgIdx + imgSpd) mod 4
    
    if rockTimer
    {
        imgSpd = 0.25
    }
    else
    {
        imgIdx = 0;
        imgSpd = 0;
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
