        <arguments>
          <argument>
            <kind>1</kind>
            <string>//event_inherited();

if (!dead)
{
    if (plyr != noone)
    {   
        var imgs = floor(image_number / 4);
        
        draw_sprite_ext(spr, imgIdx, round(x), round(y), image_xscale, image_yscale, image_angle, c_white, image_alpha);
        draw_sprite_ext(spr, imgIdx + imgs, round(x), round(y), image_xscale, image_yscale, image_angle, primCol, image_alpha);
        draw_sprite_ext(spr, imgIdx + imgs * 2, round(x), round(y), image_xscale, image_yscale, image_angle, secCol, image_alpha);
        draw_sprite_ext(spr, imgIdx + imgs * 3, round(x), round(y), image_xscale, image_yscale, image_angle, global.outlineCol[plyrID], image_alpha);
    }
    else
    {
        draw_sprite_ext(spr, imgIdx, round(x), round(y), image_xscale, image_yscale, image_angle, c_white, image_alpha);
    }
}
</string>
