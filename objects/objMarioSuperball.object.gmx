            <string>if (global.keyShootPressed[playerID] &amp;&amp; !playerIsLocked(PL_LOCK_SHOOT))
{
    var i = fireWeapon(25, -1, objMarioSuperball, 2, 2, 2, 0);
    if (i) // set starting speed
    {
        playSFX(sfxMarioSuperball)
        
        if global.keyUp[playerID]
        {
            i.angle = 90 - (45 * image_xscale);
        }
        else
        {
            i.angle = 270 + (45 * image_xscale);
        }
    }
}
</string>
          </argument>
